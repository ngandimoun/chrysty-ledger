{
  "functions": {
    "src/app/api/chat/route.ts": { "maxDuration": 300 },
    "src/app/api/speech/transcribe/route.ts": { "maxDuration": 60 },
    "src/app/api/workspace/[id]/agent/bulk-import/route.ts": { "maxDuration": 300 },
    "src/app/api/workspace/[id]/agent/expense-analysis/route.ts": { "maxDuration": 300 },
    "src/app/api/agent/runs/[id]/resume/route.ts": { "maxDuration": 300 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
