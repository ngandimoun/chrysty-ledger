# Copy to .env.local and fill in your values.

# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables



# App (production: https://ledger.chrysty.dev)

NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_WORKER_SLUG=ledger



# Chrysty platform API

NEXT_PUBLIC_CHRYSTY_API_URL=https://api.chrysty.dev

CHRYSTY_API_URL=https://api.chrysty.dev



# Supabase (shared chrysty project)

NEXT_PUBLIC_SUPABASE_URL=

NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_UPLOADS_BUCKET=ledger-uploads



# Supabase Postgres — use transaction pooler for Vercel serverless (port 6543, ?pgbouncer=true)
DATABASE_URL=

# Vercel serverless budget (ms). Must be less than maxDuration (300s on Pro).
SERVERLESS_BUDGET_MS=280000

# Moonshot Kimi API — https://platform.kimi.ai/docs/llms.txt

MOONSHOT_API_KEY=

MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

MOONSHOT_MODEL=kimi-k2.6

MOONSHOT_MAX_HISTORY_MESSAGES=20

MOONSHOT_VISION_INLINE_MAX_BYTES=5242880

MOONSHOT_MAX_RETRIES=3

MOONSHOT_RETRY_DELAY_MS=1000

MOONSHOT_AUTO_DELETE_FILES=true

MOONSHOT_MAX_FILE_BYTES=104857600

MOONSHOT_FILE_READY_TIMEOUT_MS=90000

MOONSHOT_BATCH_POLL_INTERVAL_MS=10000

MOONSHOT_BATCH_COMPLETION_WINDOW=24h

MOONSHOT_BATCH_MAX_TOKENS=32768

MOONSHOT_WEB_SEARCH_MODE=builtin

MOONSHOT_OFFICIAL_TOOLS=

# Optional comma-separated formula subset (empty = all; unavailable formulas are skipped automatically)
# MOONSHOT_OFFICIAL_TOOLS=excel,date,fetch,convert,quickjs,code-runner

MOONSHOT_TOOL_LOOP_MAX_ROUNDS=6

MOONSHOT_FORMULA_FIBER_TIMEOUT_MS=45000



# Gemini API (Google AI Studio) — speech-to-text in the chat prompt

GOOGLE_API_KEY=

GEMINI_STT_MODEL=gemini-3.1-flash-lite



# Trigger.dev — https://trigger.dev/docs

TRIGGER_SECRET_KEY=

TRIGGER_PROJECT_REF=



# Deprecated: use MOONSHOT_API_KEY instead (Kimi API is OpenAI-compatible at api.moonshot.ai)

# OPENAI_API_KEY=

#Run dev with background jobs:
#npm run dev
#npm run trigger:dev
#Link your Trigger.dev project ref in trigger.config.ts (replace proj_ledger placeholder if needed)